<Window x:Class="AnimeWallpaper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AnimeWallpaper.ViewModels"
        mc:Ignorable="d"
        Title="Anime Wallpaper"
        Height="780" Width="520"
        MinHeight="680" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F14"
        Foreground="#EDEDED"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        BorderBrush="#2D2D3D"
        BorderThickness="1">

    <Window.Resources>
        <!-- Modern Dark Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#0F0F14" />
        <SolidColorBrush x:Key="CardBg" Color="#181824" />
        <SolidColorBrush x:Key="CardBorder" Color="#282838" />
        <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6" />
        <SolidColorBrush x:Key="AccentPurpleHover" Color="#7C3AED" />
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF" />
        <SolidColorBrush x:Key="InputBg" Color="#202030" />

        <!-- Control Styles -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentPurple}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Dark Mode Templates & Styles -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <Border x:Name="border"
                        Grid.ColumnSpan="2"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8" />
                <Path x:Name="arrow"
                      Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z"
                      Fill="#9CA3AF" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPurple}" />
                    <Setter TargetName="arrow" Property="Fill" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPurple}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                Margin="4,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2A2A3E" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource AccentPurple}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7,30,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Focusable="false"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#181824"
                                            BorderThickness="1"
                                            BorderBrush="#38384E"
                                            CornerRadius="8"
                                            Margin="0,4,0,4">
                                        <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentPurple}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="chkBox"
                                    Width="18" Height="18"
                                    Background="{StaticResource InputBg}"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1.5"
                                    CornerRadius="4"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                                <Path x:Name="checkMark"
                                      Data="M 3 8 L 7 12 L 14 4"
                                      Stroke="{StaticResource AccentPurple}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="chkBox" Property="BorderBrush" Value="{StaticResource AccentPurple}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chkBox" Property="BorderBrush" Value="{StaticResource AccentPurple}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentPurple}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPurpleHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#252536" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#323246" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPurple}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetChipBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E1E2C" />
            <Setter Property="Foreground" Value="#C4B5FD" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#33334A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPurple}" />
                                <Setter TargetName="border" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#252536" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />  <!-- Custom Title Bar -->
            <RowDefinition Height="*" />   <!-- Main Content Scroll -->
            <RowDefinition Height="46" />  <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. CUSTOM TITLE BAR -->
        <Border Grid.Row="0" Background="#14141D" MouseDown="TitleBar_MouseDown" BorderBrush="#20202E" BorderThickness="0,0,0,1">
            <Grid Margin="12,0,4,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Resources/app.png" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Anime Wallpaper" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    <TextBlock Text="v1.0" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="6,2,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource TitleBarBtn}" ToolTip="Minimize to Tray" Click="MinimizeBtn_Click">
                        <TextBlock Text="—" FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource CloseBtn}" ToolTip="Close to Tray (Keeps running in background)" Click="CloseBtn_Click">
                        <TextBlock Text="✕" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. SCROLLABLE MAIN BODY -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,14,18,14">

                <!-- WALLPAPER PREVIEW CARD -->
                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="200" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Wallpaper Preview" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="View on Wallhaven" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0" Command="{Binding OpenInBrowserCommand}" />
                                <Button Content="Folder" Style="{StaticResource SecondaryBtn}" Command="{Binding OpenCacheFolderCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- Image Preview Box -->
                        <Border Grid.Row="1" Background="#0A0A0F" CornerRadius="8" ClipToBounds="True" BorderBrush="#222230" BorderThickness="1">
                            <Grid>
                                <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                
                                <!-- Fallback text if no image yet -->
                                <TextBlock Text="No wallpaper downloaded yet"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- Metadata Badges -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#1E1E2C" CornerRadius="6" Padding="8,4" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="WALLPAPER ID" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Text="{Binding WallpaperId}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#1E1E2C" CornerRadius="6" Padding="8,4" Margin="2,0,2,0">
                                <StackPanel>
                                    <TextBlock Text="RESOLUTION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Text="{Binding Resolution}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#1E1E2C" CornerRadius="6" Padding="8,4" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="LAST CHANGED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Text="{Binding LastChangedText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- SETTINGS & CONFIGURATION CARD -->
                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Wallpaper Settings" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12" />

                        <!-- Source -->
                        <TextBlock Text="Source" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                        <Border Background="#1F1F2E" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                            <TextBlock Text="Wallhaven (Anime - API v1)" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                        </Border>

                        <!-- Query -->
                        <TextBlock Text="Search Query" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                        <!-- Preset Chips -->
                        <ItemsControl ItemsSource="{Binding PresetQueries}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                            Style="{StaticResource PresetChipBtn}"
                                            Command="{Binding DataContext.SetPresetQueryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Change Wallpaper Interval -->
                        <TextBlock Text="Change Wallpaper Interval" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,4" />
                        <ComboBox ItemsSource="{Binding IntervalOptions}"
                                  SelectedItem="{Binding SelectedInterval}"
                                  Margin="0,0,0,10" />

                        <!-- Minimum Resolution -->
                        <TextBlock Text="Minimum Resolution" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding MinimumWidth, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="1" Text="×" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                            <TextBox Grid.Column="2" Text="{Binding MinimumHeight, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!-- Checkboxes Grid -->
                        <StackPanel Margin="0,2,0,6">
                            <CheckBox IsChecked="{Binding Random}" Content="Random wallpaper rotation" />
                            <CheckBox IsChecked="{Binding SfwOnly}" Content="SFW only (Safe for work)" />
                            <CheckBox IsChecked="{Binding StartWithWindows}" Content="Start with Windows (System Tray)" />
                            <CheckBox IsChecked="{Binding ShowNotifications}" Content="Show notification when wallpaper changes" />
                        </StackPanel>

                        <!-- Optional Wallhaven API Key -->
                        <Expander Header="Wallhaven API Key &amp; Cache Options" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Wallhaven API Key (Optional):" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding WallhavenApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Max Cached Wallpapers:" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                                    <TextBox Grid.Column="1" Text="{Binding MaxCachedWallpapers, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <Button Content="Save Settings" Style="{StaticResource SecondaryBtn}" Command="{Binding SaveSettingsCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- ACTION BUTTONS -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource PrimaryBtn}" Content="Next Wallpaper" Command="{Binding NextWallpaperCommand}" />
                    <Button Grid.Column="2" Style="{StaticResource SecondaryBtn}" Content="{Binding PauseButtonText}" FontSize="13" Command="{Binding TogglePauseCommand}" />
                </Grid>

                <!-- UTILITY BUTTONS BAR -->
                <UniformGrid Columns="3" Margin="0,0,0,4">
                    <Button Content="Cache Folder" Style="{StaticResource SecondaryBtn}" Margin="0,0,4,0" Command="{Binding OpenCacheFolderCommand}" />
                    <Button Content="Clear Cache" Style="{StaticResource SecondaryBtn}" Margin="2,0,2,0" Command="{Binding ClearCacheCommand}" />
                    <Button Content="Open Logs" Style="{StaticResource SecondaryBtn}" Margin="4,0,0,0" Command="{Binding OpenLogsCommand}" />
                </UniformGrid>

                <!-- User notification toast banner -->
                <Border Background="#1E1E2C" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UserNotification}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding UserNotification, Converter={x:Null}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding UserNotification}" Foreground="{StaticResource AccentCyan}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" />
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 3. MODERN STATUS BAR -->
        <Border Grid.Row="2" Background="#14141D" BorderBrush="#20202E" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,8,0" />
                    <TextBlock Text="Status: " FontSize="12" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                </StackPanel>

                <!-- Next wallpaper countdown -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Next: " FontSize="12" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding CountdownText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentPurple}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
