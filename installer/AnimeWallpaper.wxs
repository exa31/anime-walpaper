<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*"
             Name="Anime Wallpaper"
             Language="1033"
             Version="$(var.ProductVersion)"
             Manufacturer="exa31"
             UpgradeCode="F2E3D4C5-B6A7-8901-CDEF-123456789ABC">

        <Package InstallerVersion="500"
                 Compressed="yes"
                 InstallScope="perMachine"
                 Description="Anime Wallpaper - Automated Wallpaper Rotator"
                 Comments="Automated Anime Wallpaper rotator for Windows 10/11 using Wallhaven API" />

        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <Icon Id="AppIcon" SourceFile="$(var.SourceDir)\Resources\app.ico" />
        <Property Id="ARPPRODUCTICON" Value="AppIcon" />
        <Property Id="ARPHELPLINK" Value="https://github.com/exa31/anime-walpaper" />

        <!-- Directory Structure -->
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLFOLDER" Name="Anime Wallpaper" />
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="Anime Wallpaper" />
            </Directory>
        </Directory>

        <!-- Components -->
        <DirectoryRef Id="INSTALLFOLDER">
            <Component Id="MainExecutable" Guid="E3F4A5B6-C7D8-9012-DEFA-23456789ABCD" Win64="yes">
                <File Id="AnimeWallpaperEXE"
                      Source="$(var.PublishDir)\AnimeWallpaper.exe"
                      KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <!-- Start Menu Shortcut -->
        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="D4E5F6A7-B8C9-0123-EFAB-3456789ABCDE">
                <Shortcut Id="ApplicationStartMenuShortcut"
                          Name="Anime Wallpaper"
                          Description="Launch Anime Wallpaper"
                          Target="[INSTALLFOLDER]AnimeWallpaper.exe"
                          WorkingDirectory="INSTALLFOLDER"
                          Icon="AppIcon" />
                <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
                <RegistryValue Root="HKCU"
                               Key="Software\exa31\AnimeWallpaper"
                               Name="installed"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <!-- Features -->
        <Feature Id="ProductFeature" Title="Anime Wallpaper" Level="1">
            <ComponentRef Id="MainExecutable" />
            <ComponentRef Id="ApplicationShortcut" />
        </Feature>

        <!-- UI -->
        <UIRef Id="WixUI_Minimal" />
        <WixVariable Id="WixUILicenseRtf" Value="$(var.SourceDir)\installer\license.rtf" />
    </Product>
</Wix>
