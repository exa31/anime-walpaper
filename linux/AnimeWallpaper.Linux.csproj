<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>anime-wallpaper</AssemblyName>
    <RootNamespace>AnimeWallpaper.Linux</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>exa31</Authors>
    <Description>Lightweight automated Anime Wallpaper daemon and CLI for Linux desktop environments</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
